<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <ThingDef ParentName="AnimalThingBase">
    <defName>EI_Wolfhound</defName>
    <label>wolfhound</label>
    <description>A large domestic coursing hound bred for speed and close combat. Wolfhounds run down threats quickly and can be trained to guard and attack, but they cannot rescue or haul. They are costly to feed, dirty indoors, slow to mature, short-lived, and valuable enough to add significant colony wealth. They follow orders; they do not patrol or protect livestock on their own.</description>
    <statBases>
      <MoveSpeed>5.4</MoveSpeed>
      <MarketValue>380</MarketValue>
      <ComfyTemperatureMin>-30</ComfyTemperatureMin>
      <FilthRate>6</FilthRate>
      <Wildness>0</Wildness>
    </statBases>
    <uiIconScale>1.15</uiIconScale>
    <tools>
      <li>
        <label>left claw</label>
        <labelNoLocation>claw</labelNoLocation>
        <capacities>
          <li>Scratch</li>
        </capacities>
        <power>9.8</power>
        <cooldownTime>2</cooldownTime>
        <linkedBodyPartsGroup>FrontLeftPaw</linkedBodyPartsGroup>
      </li>
      <li>
        <label>right claw</label>
        <labelNoLocation>claw</labelNoLocation>
        <capacities>
          <li>Scratch</li>
        </capacities>
        <power>9.8</power>
        <cooldownTime>2</cooldownTime>
        <linkedBodyPartsGroup>FrontRightPaw</linkedBodyPartsGroup>
      </li>
      <li>
        <capacities>
          <li>Bite</li>
        </capacities>
        <power>16</power>
        <cooldownTime>2.6</cooldownTime>
        <linkedBodyPartsGroup>Teeth</linkedBodyPartsGroup>
        <chanceFactor>0.7</chanceFactor>
      </li>
      <li>
        <label>head</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>6</power>
        <cooldownTime>2</cooldownTime>
        <linkedBodyPartsGroup>HeadAttackTool</linkedBodyPartsGroup>
        <ensureLinkedBodyPartsGroupAlwaysUsable>true</ensureLinkedBodyPartsGroupAlwaysUsable>
        <chanceFactor>0.2</chanceFactor>
      </li>
    </tools>
    <race>
      <animalType>Canine</animalType>
      <body>QuadrupedAnimalWithPawsAndTail</body>
      <petness>1</petness>
      <baseBodySize>1.05</baseBodySize>
      <baseHungerRate>0.60</baseHungerRate>
      <baseHealthScale>1.0</baseHealthScale>
      <foodType>OmnivoreAnimal, OvivoreAnimal</foodType>
      <leatherDef>Leather_Dog</leatherDef>
      <gestationPeriodDays>12</gestationPeriodDays>
      <nameOnTameChance>1</nameOnTameChance>
      <trainability>Intermediate</trainability>
      <specialTrainables>
        <li MayRequire="Ludeon.RimWorld.Odyssey">AttackTarget</li>
      </specialTrainables>
      <nuzzleMtbHours>24</nuzzleMtbHours>
      <soundEating>PredatorSmall_Eat</soundEating>
      <litterSizeCurve>
        <points>
          <li>(0.5, 0)</li>
          <li>(1, 1)</li>
          <li>(2, 0.35)</li>
          <li>(2.5, 0)</li>
        </points>
      </litterSizeCurve>
      <lifeExpectancy>8</lifeExpectancy>
      <lifeStageAges>
        <li>
          <def>AnimalBaby</def>
          <minAge>0</minAge>
        </li>
        <li>
          <def>AnimalJuvenile</def>
          <minAge>0.3</minAge>
        </li>
        <li>
          <def>AnimalAdult</def>
          <minAge>0.8</minAge>
          <soundWounded>Pawn_Dog_Injured</soundWounded>
          <soundDeath>Pawn_Dog_Death</soundDeath>
          <soundCall>Pawn_Dog_Call</soundCall>
          <soundAngry>Pawn_Dog_Angry</soundAngry>
        </li>
      </lifeStageAges>
      <soundMeleeHitPawn>Pawn_Melee_SmallScratch_HitPawn</soundMeleeHitPawn>
      <soundMeleeHitBuilding>Pawn_Melee_SmallScratch_HitBuilding</soundMeleeHitBuilding>
      <soundMeleeMiss>Pawn_Melee_SmallScratch_Miss</soundMeleeMiss>
      <headPosPerRotation>
        <li>(0.0, 0, 0.24)</li>
        <li>(0.28, 0, 0.14)</li>
        <li>(0.0, 0, -0.03)</li>
        <li>(-0.28, 0, 0.14)</li>
      </headPosPerRotation>
    </race>
    <tradeTags>
      <li>AnimalUncommon</li>
      <li>AnimalFighter</li>
    </tradeTags>
  </ThingDef>

